rules_version = '2';

// ===============================================================
// FieldRead OS - Cloud Firestore Security Rules
// ===============================================================
// Production-grade security rules and schema validation for
// FieldRead OS Tactical Courtship Decision Engine backend.
//
// Assumed Data Models:
// ---------------------------------------------------------------
// 1. wallets/{uid}
//    - uid / userId: string (matches document id / auth.uid)
//    - balancePaise: number (>= 0)
//    - singleScanUnlockTokens: number (>= 0)
//    - freeDailyScansRemaining: number (>= 0)
//    - currency: 'INR' | 'USD'
//    - Read: Owner only (request.auth.uid == uid)
//    - Write: Strictly forbidden from client (Admin SDK only)
//
// 2. coaches/{coachId}
//    - id / coachId: string (matches auth.uid)
//    - alias: string (1-64 chars)
//    - bio: string (optional, <= 2000 chars)
//    - avatarUrl: string (optional, <= 2000 chars)
//    - isDutyOn: bool
//    - withdrawablePaise: number (MUTATED BY ADMIN SDK ONLY)
//    - baseRatePerMinuteInr: number (>= 0)
//    - upiVpa: string (<= 100 chars)
//    - panNumber: string (Section 194J TDS)
//    - kycStatus: 'PENDING' | 'VERIFIED' | 'REJECTED'
//    - Read: Authenticated users
//    - Create/Delete: Forbidden from client
//    - Update: Coach only (request.auth.uid == coachId), withdrawablePaise immutable
//
// 3. prospects/{prospectId}
//    - id: string (<= 128 chars)
//    - userId: string (matches auth.uid)
//    - name: string (<= 100 chars)
//    - platform: string (<= 50 chars)
//    - stage: string (<= 50 chars)
//    - tensionState: string (<= 50 chars)
//    - lastMessageSnippet: string (optional, <= 2000 chars)
//    - notes: string (optional, <= 10000 chars)
//    - recommendedMove: string (optional, <= 2000 chars)
//    - cooldownEndsAt: number (optional)
//    - history: list of maps (optional, <= 500 items)
//    - Read/Delete: Owner only (resource.data.userId == request.auth.uid)
//    - Create: Owner only (request.resource.data.userId == request.auth.uid)
//    - Update: Owner only (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
//
// 4. scans/{scanId} & situations/{situationId}
//    - id / scanId: string (<= 128 chars)
//    - userId: string (matches auth.uid)
//    - prospectId: string (optional, <= 128 chars)
//    - inputMode: 'paste' | 'screenshot' | 'voice'
//    - herMessage: string (<= 5000 chars)
//    - userDraft: string (optional, <= 5000 chars)
//    - region: string (optional, <= 100 chars)
//    - platform: string (optional, <= 50 chars)
//    - icfuCategory: string (optional, <= 50 chars)
//    - draftCritique: string (optional, <= 10000 chars)
//    - calibratedMoves: list (optional, <= 20 items)
//    - rawGeminiResponse: string (optional, <= 50000 chars)
//    - Read/Delete: Owner only (resource.data.userId == request.auth.uid)
//    - Create: Owner only (request.resource.data.userId == request.auth.uid)
//    - Update: Owner only (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
//
// 5. decks/{deckId}
//    - id / deck_id: string
//    - title: string
//    - subtitle: string
//    - is_free_preview: bool
//    - isPro: bool
//    - cardCount: number
//    - Read: Free preview OR user.isPro == true OR deckId/deck_id in user.unlockedDecks
//    - Write: Forbidden from client (Admin SDK only)
//
// 6. cards/{cardId}
//    - id / card_id: string
//    - deckId / deck_id: string
//    - title: string
//    - is_free_preview: bool
//    - Read: Free preview OR user.isPro == true OR card's deckId/deck_id in user.unlockedDecks
//    - Write: Forbidden from client (Admin SDK only)
//
// 7. users/{userId}
//    - id / uid: string (matches userId)
//    - alias: string (<= 64 chars)
//    - isPro: bool (MUTATED BY ADMIN SDK ONLY)
//    - unlockedDecks: list of strings (MUTATED BY ADMIN SDK ONLY)
//    - freeDailyScans: number (>= 0)
//    - preferences: map
//    - Read: Owner only (request.auth.uid == userId)
//    - Write: Owner only (request.auth.uid == userId), cannot self-grant isPro or alter unlockedDecks
//
// 8. transactions/{txId} & wallet_transactions/{txId}
//    - userId: string
//    - amount: number
//    - currency: 'INR' | 'USD'
//    - type: string
//    - status: string
//    - Read: Owner only (request.auth.uid == resource.data.userId)
//    - Write: Forbidden from client (Admin SDK only)
//
// 9. warRoomSessions/{sessionId} & liveSessions/{sessionId}
//    - id / sessionId: string
//    - userId / clientId: string
//    - coachId: string
//    - status: 'ringing' | 'active' | 'completed' | 'cancelled' | 'timed_out'
//    - teleprompterLogs: list of maps
//    - Read/Write: Session participants (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.coachId)
//
// 10. photoAudits/{auditId}
//    - id: string
//    - userId: string
//    - photoUrls: list of strings (<= 20 items)
//    - overallEloScore: number
//    - rankings: list of maps (<= 50 items)
//    - Read/Write: Owner (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid)
//
// 11. voiceNotes/{voiceNoteId}
//    - id: string
//    - userId: string
//    - drillScenarioId: string
//    - drillMode: 'voicenote' | 'call'
//    - Read/Write: Owner (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Common Helper Functions
    // ===============================================================

    // Check if client request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if client is the document owner by matching auth UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check that immutable fields have not been altered in an update operation
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate timestamp or ISO string format
    function isValidTimestamp(val) {
      return val is timestamp || (val is string && val.size() >= 10 && val.size() <= 40);
    }

    // Check if the current user is a session participant (user, client, or coach)
    function isSessionParticipant(data) {
      return isAuthenticated() && (
        (('userId' in data) && request.auth.uid == data.userId) ||
        (('clientId' in data) && request.auth.uid == data.clientId) ||
        (('coachId' in data) && request.auth.uid == data.coachId)
      );
    }

    // ===============================================================
    // Domain Validator Functions (Validator Function Pattern)
    // ===============================================================

    // --- Users Collection Validator ---
    function isValidUser(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
        (!('alias' in data) || (data.alias is string && data.alias.size() <= 64)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 25)) &&
        (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 10)) &&
        (!('isPro' in data) || (data.isPro is bool)) &&
        (!('unlockedDecks' in data) || (data.unlockedDecks is list && data.unlockedDecks.size() <= 100)) &&
        (!('freeDailyScans' in data) || (data.freeDailyScans is number && data.freeDailyScans >= 0)) &&
        (!('freeDailyScansRemaining' in data) || (data.freeDailyScansRemaining is number && data.freeDailyScansRemaining >= 0)) &&
        (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0)) &&
        (!('activeProspectCount' in data) || (data.activeProspectCount is number && data.activeProspectCount >= 0)) &&
        (!('preferences' in data) || (data.preferences is map));
    }

    // --- Coach Update Validator ---
    function isValidCoachUpdate(data) {
      return (!('isDutyOn' in data) || data.isDutyOn is bool) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&
        (!('alias' in data) || (data.alias is string && data.alias.size() >= 1 && data.alias.size() <= 64)) &&
        (!('baseRatePerMinuteInr' in data) || (data.baseRatePerMinuteInr is number && data.baseRatePerMinuteInr >= 0)) &&
        (!('upiVpa' in data) || (data.upiVpa is string && data.upiVpa.size() <= 100));
    }

    // --- Prospects Collection Validator ---
    function isValidProspect(data) {
      return data.userId is string && data.userId.size() <= 128 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 50)) &&
        (!('stage' in data) || (data.stage is string && data.stage.size() <= 50)) &&
        (!('tensionState' in data) || (data.tensionState is string && data.tensionState.size() <= 50)) &&
        (!('matchedTime' in data) || (data.matchedTime is string && data.matchedTime.size() <= 100)) &&
        (!('lastMessageSnippet' in data) || (data.lastMessageSnippet is string && data.lastMessageSnippet.size() <= 2000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000)) &&
        (!('recommendedMove' in data) || (data.recommendedMove is string && data.recommendedMove.size() <= 2000)) &&
        (!('cooldownEndsAt' in data) || (data.cooldownEndsAt is number)) &&
        (!('cooldownReason' in data) || (data.cooldownReason is string && data.cooldownReason.size() <= 1000)) &&
        (!('venueDetails' in data) || (data.venueDetails is map)) &&
        (!('fieldReport' in data) || (data.fieldReport is map)) &&
        (!('history' in data) || (data.history is list && data.history.size() <= 500)) &&
        (!('pastRedFlags' in data) || (data.pastRedFlags is list && data.pastRedFlags.size() <= 50));
    }

    // --- Scans & Situations Collection Validator ---
    function isValidScan(data) {
      return data.userId is string && data.userId.size() <= 128 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('scanId' in data) || (data.scanId is string && data.scanId.size() <= 128)) &&
        (!('prospectId' in data) || (data.prospectId is string && data.prospectId.size() <= 128)) &&
        (!('inputMode' in data) || (data.inputMode in ['paste', 'screenshot', 'voice'])) &&
        (!('herMessage' in data) || (data.herMessage is string && data.herMessage.size() <= 5000)) &&
        (!('userDraft' in data) || (data.userDraft is string && data.userDraft.size() <= 5000)) &&
        (!('region' in data) || (data.region is string && data.region.size() <= 100)) &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 50)) &&
        (!('draftCritique' in data) || (data.draftCritique is string && data.draftCritique.size() <= 10000)) &&
        (!('interestScore' in data) || (data.interestScore is number)) &&
        (!('calibratedMoves' in data) || (data.calibratedMoves is list && data.calibratedMoves.size() <= 20)) &&
        (!('rawGeminiResponse' in data) || (data.rawGeminiResponse is string && data.rawGeminiResponse.size() <= 50000));
    }

    // --- Live & War Room Sessions Validator ---
    function isValidLiveSession(data) {
      return (!('status' in data) || (data.status in ['ringing', 'active', 'completed', 'cancelled', 'timed_out'])) &&
        (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 100)) &&
        (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000)) &&
        (!('behavioralTrap' in data) || (data.behavioralTrap is string && data.behavioralTrap.size() <= 2000)) &&
        (!('recommendedStrategy' in data) || (data.recommendedStrategy is string && data.recommendedStrategy.size() <= 2000)) &&
        (!('teleprompterLogs' in data) || (data.teleprompterLogs is list && data.teleprompterLogs.size() <= 500));
    }

    // --- Photo Audits Validator ---
    function isValidPhotoAudit(data) {
      return data.userId is string && data.userId.size() <= 128 &&
        (!('photoUrls' in data) || (data.photoUrls is list && data.photoUrls.size() <= 20)) &&
        (!('overallEloScore' in data) || (data.overallEloScore is number)) &&
        (!('rankings' in data) || (data.rankings is list && data.rankings.size() <= 50)) &&
        (!('recommendations' in data) || (data.recommendations is list && data.recommendations.size() <= 50)) &&
        (!('coachNotes' in data) || (data.coachNotes is string && data.coachNotes.size() <= 5000));
    }

    // --- Voice Notes Validator ---
    function isValidVoiceNote(data) {
      return data.userId is string && data.userId.size() <= 128 &&
        (!('drillScenarioId' in data) || (data.drillScenarioId is string && data.drillScenarioId.size() <= 50)) &&
        (!('drillMode' in data) || (data.drillMode in ['voicenote', 'call'])) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0)) &&
        (!('audioStoragePath' in data) || (data.audioStoragePath is string && data.audioStoragePath.size() <= 500)) &&
        (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2000)) &&
        (!('transcription' in data) || (data.transcription is string && data.transcription.size() <= 10000)) &&
        (!('metrics' in data) || (data.metrics is map)) &&
        (!('feedback' in data) || (data.feedback is map));
    }

    // ===============================================================
    // Collection Access Control Rules
    // ===============================================================

    // ---------------------------------------------------------------
    // 1. wallets/{uid}
    // Read: ONLY if request.auth != null && request.auth.uid == uid.
    // Write: Strictly forbidden (false). Mutated via Admin SDK only.
    // ---------------------------------------------------------------
    match /wallets/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 2. coaches/{coachId}
    // Read: Authenticated users.
    // Create & Delete: Forbidden from client (false).
    // Update: Coach only (request.auth.uid == coachId).
    //   withdrawablePaise CANNOT be modified or introduced by client:
    //   request.resource.data.withdrawablePaise == resource.data.withdrawablePaise
    // ---------------------------------------------------------------
    match /coaches/{coachId} {
      allow read: if isAuthenticated();
      allow create, delete: if false;

      allow update: if isAuthenticated() &&
        request.auth.uid == coachId &&
        // withdrawablePaise CANNOT be modified by client (and if absent, cannot be introduced)
        ((!('withdrawablePaise' in resource.data) && !('withdrawablePaise' in request.resource.data)) ||
         (('withdrawablePaise' in resource.data) && ('withdrawablePaise' in request.resource.data) &&
          request.resource.data.withdrawablePaise == resource.data.withdrawablePaise)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['withdrawablePaise']) &&
        isValidCoachUpdate(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'coachId', 'createdAt', 'kycStatus', 'totalEarningsInr', 'pendingPayoutInr', 'totalWithdrawnInr', 'withdrawablePaise']);
    }

    // ---------------------------------------------------------------
    // 3. prospects/{prospectId}
    // Read/Delete: request.auth != null && resource.data.userId == request.auth.uid
    // Create: request.auth != null && request.resource.data.userId == request.auth.uid
    // Update: request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid
    // ---------------------------------------------------------------
    match /prospects/{prospectId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidProspect(request.resource.data);

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidProspect(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
    }

    // ---------------------------------------------------------------
    // 4. scans/{scanId} & situations/{situationId}
    // Read/Delete: request.auth != null && resource.data.userId == request.auth.uid
    // Create: request.auth != null && request.resource.data.userId == request.auth.uid
    // Update: request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid
    // ---------------------------------------------------------------
    match /scans/{scanId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidScan(request.resource.data);

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidScan(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'scanId', 'userId', 'createdAt']);
    }

    match /situations/{situationId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidScan(request.resource.data);

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidScan(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'scanId', 'userId', 'createdAt']);
    }

    // ---------------------------------------------------------------
    // 5. decks/{deckId}
    // Client write: Forbidden (false).
    // Read:
    //   resource.data.is_free_preview == true OR if user is authenticated and:
    //   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true OR
    //   deckId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks OR
    //   ('deck_id' in resource.data && resource.data.deck_id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks)
    // ---------------------------------------------------------------
    match /decks/{deckId} {
      allow read: if (('is_free_preview' in resource.data) && resource.data.is_free_preview == true) ||
        (isAuthenticated() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true ||
          ('unlockedDecks' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            (deckId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks ||
             (('deck_id' in resource.data) && resource.data.deck_id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks)))
        ));

      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 6. cards/{cardId}
    // Client write: Forbidden (false).
    // Read:
    //   resource.data.is_free_preview == true OR if user is authenticated and:
    //   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true OR
    //   ('deckId' in resource.data && resource.data.deckId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks) OR
    //   ('deck_id' in resource.data && resource.data.deck_id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks)
    // ---------------------------------------------------------------
    match /cards/{cardId} {
      allow read: if (('is_free_preview' in resource.data) && resource.data.is_free_preview == true) ||
        (isAuthenticated() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true ||
          ('unlockedDecks' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            ((('deckId' in resource.data) && resource.data.deckId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks) ||
             (('deck_id' in resource.data) && resource.data.deck_id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedDecks)))
        ));

      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 7. users/{userId}
    // Read: request.auth != null && request.auth.uid == userId
    // Write: request.auth != null && request.auth.uid == userId,
    //   ensuring client cannot self-grant isPro or alter unlockedDecks
    //   on update: request.resource.data.isPro == resource.data.isPro &&
    //              request.resource.data.unlockedDecks == resource.data.unlockedDecks
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;

      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidUser(request.resource.data) &&
        // Prevent self-granting isPro or unlockedDecks on creation
        (!('isPro' in request.resource.data) || request.resource.data.isPro == false) &&
        (!('unlockedDecks' in request.resource.data) || request.resource.data.unlockedDecks.size() == 0);

      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidUser(request.resource.data) &&
        // isPro and unlockedDecks are strictly immutable from client
        request.resource.data.isPro == resource.data.isPro &&
        request.resource.data.unlockedDecks == resource.data.unlockedDecks &&
        areImmutableFieldsUnchanged(['id', 'uid', 'createdAt']);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // 8. transactions/{txId} & wallet_transactions/{txId}
    // Read: request.auth != null && resource.data.userId == request.auth.uid
    // Write: false (Admin SDK only)
    // ---------------------------------------------------------------
    match /transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 9. warRoomSessions/{sessionId} & liveSessions/{sessionId}
    // Read/write: Allowed for session participants
    //   (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.coachId)
    // ---------------------------------------------------------------
    match /warRoomSessions/{sessionId} {
      allow read, delete: if isSessionParticipant(resource.data);

      allow create: if isSessionParticipant(request.resource.data) &&
        isValidLiveSession(request.resource.data);

      allow update: if isSessionParticipant(resource.data) &&
        isValidLiveSession(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'sessionId', 'createdAt']);
    }

    match /liveSessions/{sessionId} {
      allow read, delete: if isSessionParticipant(resource.data);

      allow create: if isSessionParticipant(request.resource.data) &&
        isValidLiveSession(request.resource.data);

      allow update: if isSessionParticipant(resource.data) &&
        isValidLiveSession(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'sessionId', 'createdAt']);
    }

    // ---------------------------------------------------------------
    // 10. photoAudits/{auditId}
    // Read/write: Allowed for owner
    //   (request.auth != null && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid))
    // ---------------------------------------------------------------
    match /photoAudits/{auditId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidPhotoAudit(request.resource.data);

      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        isValidPhotoAudit(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
    }

    // ---------------------------------------------------------------
    // 11. voiceNotes/{voiceNoteId}
    // Bio-telemetry and tonality calibrations.
    // Read/write: Owner only.
    // ---------------------------------------------------------------
    match /voiceNotes/{voiceNoteId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidVoiceNote(request.resource.data);

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidVoiceNote(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
    }

  }
}
